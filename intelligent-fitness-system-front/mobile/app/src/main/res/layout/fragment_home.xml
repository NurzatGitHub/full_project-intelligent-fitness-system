<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ============================ -->
        <!--  HEADER: greeting + avatar    -->
        <!-- ============================ -->

        <LinearLayout
            android:id="@+id/homeProfileHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="GOOD TO SEE YOU"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="-0.01"
                    android:text="Athlete 👋"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Azamat 👋" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_avatar_ring" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="?attr/colorPrimaryContainer"
                    android:padding="11dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

        </LinearLayout>

        <!-- ============================ -->
        <!--  HERO: AI Weekly Plan         -->
        <!-- ============================ -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiWeeklyPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Pulse.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_metric_chip"
                        android:drawableStart="@drawable/ai"
                        android:drawablePadding="6dp"
                        android:drawableTint="#FFFFFF"
                        android:text="AI Coach"
                        android:textColor="#FFFFFF" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/Pulse.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_metric_chip"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="6dp"
                        android:drawableTint="#FFFFFF"
                        android:text="This week"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAiPlanTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.01"
                    android:text="AI Weekly Plan"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAiPlanSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.92"
                    android:lineSpacingExtra="2dp"
                    android:text="Generating your personalized weekly plan..."
                    android:textColor="#E8FFFFFF"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:id="@+id/hsvWeekDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDay1"
                            android:layout_width="92dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#181826"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#332D55"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:id="@+id/tvDay1Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="Mon"
                                    android:textAllCaps="true"
                                    android:textColor="#EDEAF7"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay1Type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Workout"
                                    android:textColor="@color/brand_primary_300"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay1Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:text="Chest"
                                    android:textColor="#EDEAF7"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDay2"
                            android:layout_width="92dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#181826"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#332D55"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:id="@+id/tvDay2Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="Tue"
                                    android:textAllCaps="true"
                                    android:textColor="#EDEAF7"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay2Type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Rest"
                                    android:textColor="@color/brand_primary_300"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay2Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:text="Recovery"
                                    android:textColor="#EDEAF7"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDay3"
                            android:layout_width="92dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#181826"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#332D55"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:id="@+id/tvDay3Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="Wed"
                                    android:textAllCaps="true"
                                    android:textColor="#EDEAF7"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay3Type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Workout"
                                    android:textColor="@color/brand_primary_300"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay3Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:text="Back"
                                    android:textColor="#EDEAF7"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDay4"
                            android:layout_width="92dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#181826"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#332D55"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:id="@+id/tvDay4Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="Thu"
                                    android:textAllCaps="true"
                                    android:textColor="#EDEAF7"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay4Type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Mobility"
                                    android:textColor="@color/brand_primary_300"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay4Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:text="Stretch"
                                    android:textColor="#EDEAF7"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDay5"
                            android:layout_width="92dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#181826"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#332D55"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:id="@+id/tvDay5Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="Fri"
                                    android:textAllCaps="true"
                                    android:textColor="#EDEAF7"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay5Type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Workout"
                                    android:textColor="@color/brand_primary_300"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay5Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:text="Legs"
                                    android:textColor="#EDEAF7"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDay6"
                            android:layout_width="92dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#181826"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#332D55"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:id="@+id/tvDay6Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="Sat"
                                    android:textAllCaps="true"
                                    android:textColor="#EDEAF7"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay6Type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Workout"
                                    android:textColor="@color/brand_primary_300"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay6Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:text="Full body"
                                    android:textColor="#EDEAF7"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDay7"
                            android:layout_width="92dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="#181826"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#332D55"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:id="@+id/tvDay7Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="Sun"
                                    android:textAllCaps="true"
                                    android:textColor="#EDEAF7"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay7Type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Rest"
                                    android:textColor="@color/brand_primary_300"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvDay7Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:text="Recovery"
                                    android:textColor="#EDEAF7"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#26FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_metric_chip"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_lightning"
                        app:tint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTodayPlan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTodayMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.85"
                            android:text="Your today plan will appear here"
                            android:textColor="#E8FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================ -->
        <!--  QUICK STATS                  -->
        <!-- ============================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Pulse.Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="This week" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="26dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_card_outlined"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_dumbbell"
                        app:tint="@color/brand_primary_400" />

                    <TextView
                        android:id="@+id/tvTotalWorkouts"
                        style="@style/Pulse.Text.MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="0"
                        tools:text="12" />

                    <TextView
                        style="@style/Pulse.Text.MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Workouts" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_card_outlined"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_target"
                        app:tint="@color/brand_secondary_500" />

                    <TextView
                        android:id="@+id/tvAverageFormScore"
                        style="@style/Pulse.Text.MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="0%"
                        tools:text="92%" />

                    <TextView
                        style="@style/Pulse.Text.MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Form score" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ============================ -->
        <!--  EXPLORE                      -->
        <!-- ============================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Pulse.Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Browse training" />

            <TextView
                style="@style/Pulse.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_neutral"
                android:drawableStart="@drawable/ic_lightning"
                android:drawablePadding="4dp"
                android:drawableTint="?attr/colorPrimary"
                android:text="Featured"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <com.example.fitnesscoachai.ui.home.ExpandableHeightRecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_category_card" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
