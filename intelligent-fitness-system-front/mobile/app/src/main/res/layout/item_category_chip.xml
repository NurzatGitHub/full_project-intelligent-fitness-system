<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chipCategory"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:checkable="true"
    android:text="Chest"
    android:textAppearance="@style/TextAppearance.Pulse.Label.Large"
    android:textColor="?attr/colorOnSurface"
    app:checkedIcon="@drawable/ic_check"
    app:checkedIconTint="?attr/colorOnPrimaryContainer"
    app:chipBackgroundColor="?attr/colorSurfaceContainer"
    app:chipCornerRadius="999dp"
    app:chipStrokeColor="?attr/colorOutlineVariant"
    app:chipStrokeWidth="1dp" />
