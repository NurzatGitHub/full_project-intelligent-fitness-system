<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_hero"
    android:fitsSystemWindows="true">

    <!-- App icon + name (centered at top) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroBadge"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="56dp"
        app:cardBackgroundColor="#1FFFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:letterSpacing="-0.01"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/heroBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Headline -->
    <TextView
        android:id="@+id/tvHeroTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:lineSpacingExtra="2dp"
        android:text="Train smarter,\nnot harder."
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvBrand"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subhead -->
    <TextView
        android:id="@+id/tvHeroSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Your AI coach builds a weekly plan, tracks your form on camera, and keeps you accountable — every rep."
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Feature pills -->
    <LinearLayout
        android:id="@+id/featurePills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvHeroSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/Pulse.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_metric_chip"
            android:drawableStart="@drawable/ic_camera_aperture"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand_secondary_400"
            android:text="AI Form"
            android:textColor="#FFFFFF" />

        <TextView
            style="@style/Pulse.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_metric_chip"
            android:drawableStart="@drawable/ic_target"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand_primary_200"
            android:text="Weekly Plan"
            android:textColor="#FFFFFF" />

        <TextView
            style="@style/Pulse.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_metric_chip"
            android:drawableStart="@drawable/ic_flame"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand_tertiary_400"
            android:text="Streaks"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom CTA stack -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartTraining"
            style="@style/Widget.Pulse.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/white"
            android:text="Start training"
            android:textColor="@color/brand_primary_900"
            app:icon="@drawable/ic_lightning"
            app:iconGravity="textStart"
            app:iconTint="@color/brand_primary_700" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleteProfileLater"
            style="@style/Widget.Pulse.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I&#8217;ll set up later"
            android:textColor="#CCFFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
