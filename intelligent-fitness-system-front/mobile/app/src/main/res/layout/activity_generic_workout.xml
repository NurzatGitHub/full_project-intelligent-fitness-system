<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_card_outlined"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="WORKOUT"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- Hero exercise card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivExercisePreview"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:layout_marginEnd="16dp"
                        android:background="#33FFFFFF"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Pulse.Corner.Medium"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Pulse.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_metric_chip"
                            android:drawableStart="@drawable/ic_dumbbell"
                            android:drawablePadding="6dp"
                            android:drawableTint="#FFFFFF"
                            android:text="Manual tracker"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvExerciseName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:letterSpacing="-0.01"
                            android:maxLines="2"
                            android:text="Exercise"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="Barbell Curl" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRecommended"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:alpha="0.95"
                    android:text="Tap Start when you’re ready"
                    android:textColor="#E8FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Coach suggests: 12 reps · 1 min" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Timer + Reps row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_card_outlined"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/brand_primary_400" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.02"
                        android:text="00:00"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pulse.Text.MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Timer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_card_outlined"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_dumbbell"
                        app:tint="@color/brand_secondary_500" />

                    <TextView
                        android:id="@+id/tvReps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.02"
                        android:text="0"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Pulse.Text.MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Reps" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Reps stepper -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageButton
                    android:id="@+id/btnMinusReps"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card_outlined"
                    android:contentDescription="Decrease reps"
                    android:padding="14dp"
                    android:src="@drawable/ic_minus"
                    app:tint="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Pulse.Text.MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adjust reps manually" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnPlusReps"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_btn_primary_gradient"
                    android:contentDescription="Increase reps"
                    android:padding="14dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartPause"
            style="@style/Widget.Pulse.Button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/brand_primary_500"
            android:text="Start"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            style="@style/Widget.Pulse.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Finish workout"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_check"
            app:iconTint="?attr/colorPrimary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
