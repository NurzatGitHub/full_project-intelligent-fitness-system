<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="48dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvStep"
            style="@style/Pulse.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_metric_chip"
            android:drawableStart="@drawable/ic_dumbbell"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand_primary_200"
            android:text="Step 6 of 12"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="-0.02"
            android:text="What&#8217;s your\nfitness level?"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Pick the one that feels right today — you can change it later."
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="22dp"
            android:max="100"
            app:indicatorColor="@color/brand_primary_400"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="999dp"
            app:trackThickness="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBeginner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:minHeight="56dp"
                        android:text="Beginner"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:checkedIconTint="#FFFFFF"
                        app:chipBackgroundColor="@color/chip_choice_background"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeColor="#55FFFFFF"
                        app:chipStrokeWidth="1dp"
                        app:rippleColor="#886C5CE7" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIntermediate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checkable="true"
                        android:minHeight="56dp"
                        android:text="Intermediate"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:checkedIconTint="#FFFFFF"
                        app:chipBackgroundColor="@color/chip_choice_background"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeColor="#55FFFFFF"
                        app:chipStrokeWidth="1dp"
                        app:rippleColor="#886C5CE7" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAdvanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checkable="true"
                        android:minHeight="56dp"
                        android:text="Advanced"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:checkedIconTint="#FFFFFF"
                        app:chipBackgroundColor="@color/chip_choice_background"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeColor="#55FFFFFF"
                        app:chipStrokeWidth="1dp"
                        app:rippleColor="#886C5CE7" />

                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/brand_primary_500"
                    android:enabled="false"
                    android:text="Continue"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Pulse.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="Back"
            android:textColor="#FFFFFF"
            app:cornerRadius="20dp"
            app:strokeColor="#4DFFFFFF" />

    </LinearLayout>
</ScrollView>
