<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F20B0B14"
                android:endColor="#F20B0B14" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#1A7C5CFF"
                android:endColor="#000B0B14" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
