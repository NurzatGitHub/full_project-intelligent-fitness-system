<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/brand_primary_700"
                android:centerColor="@color/brand_primary_500"
                android:endColor="@color/brand_tertiary_500" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:centerX="0.85"
                android:centerY="0.0"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>

</layer-list>
